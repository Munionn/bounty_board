# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bounty_board

# Axum server
HOST=0.0.0.0
PORT=3000

# Auth (change in production)
JWT_SECRET=dev-only-change-me

# MinIO (matches docker-compose.yml — MINIO_ROOT_USER / MINIO_ROOT_PASSWORD)
MINIO_ENDPOINT=http://localhost:9000
# Browser-facing endpoint for presigned upload/download URLs (usually same as MINIO_ENDPOINT in local dev)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=SUPERsecurepassword5.
MINIO_BUCKET=bounty-submissions
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Chat attachment limits
CHAT_MAX_FILE_BYTES=10485760

# Solana Devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
BOUNTY_PROGRAM_ID=4LSnV5QYxrXohJUHzQFUuj2YfQH3bWAscWUyQVuk4ELg
