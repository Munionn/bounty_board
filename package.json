{
  "name": "bounty_board",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "cargo build --workspace",
    "test": "cargo test --workspace",
    "check": "cargo check --workspace",
    "build:all": "cargo build --workspace",
    "test:all": "cargo test --workspace",
    "check:all": "cargo check --workspace",
    "blockchain:build": "node -e 'fs.existsSync(\"blockchain/target\") || fs.symlinkSync(\"../target\", \"blockchain/target\")' && cd blockchain && anchor build",
    "blockchain:deploy": "solana config set --url devnet && solana program deploy target/deploy/bounty_board.so --program-id target/deploy/bounty_board-keypair.json --url devnet",
    "blockchain:test": "node -e 'fs.existsSync(\"blockchain/target\") || fs.symlinkSync(\"../target\", \"blockchain/target\")' && cd blockchain && anchor test",
    "blockchain:test:unit": "cargo test -p bounty_board",
    "server:run": "cargo run -p server",
    "server:build": "cargo build -p server",
    "server:test": "cargo test -p server",
    "server:seed": "psql \"$DATABASE_URL\" -f server/seeds/dev_bounties.sql",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.4",
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
